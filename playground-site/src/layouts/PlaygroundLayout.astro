---
/**
 * Shell for /playground. Fixed-viewport app: nav header at top, four-pane
 * grid filling the rest, status bar / footer pinned at the bottom.
 *
 * Cross-site nav matches docs / blog / benchmarks: wordmark -> /, then
 * the section-label "Playground" stays in section, then the other top-
 * level destinations.
 */
import '../styles/playground.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title.endsWith('Corvid Playground') ? title : `${title} — Corvid Playground`;
const desc =
  description ??
  'Pick a Corvid example, watch the compiler analyze it in your browser. Delete an approve line and watch the diagnostic appear in real time.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="canonical" href={Astro.url.href} />

  <link rel="icon" type="image/svg+xml" href="/logos/corvid-mark.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/social/favicon-192.png" />
  <link rel="apple-touch-icon" href="/social/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,300;1,8..60,400&family=Source+Sans+3:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content="https://corvid-lang.org/social/og-cover.png" />
  <meta property="og:site_name" content="Corvid" />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <nav class="pg-nav">
    <a href="/" class="brand" aria-label="Corvid — back to home">
      <img src="/logos/corvid-mark.svg" alt="" width="32" height="32" />
      <span class="wordmark">Corvid</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="section-label">Playground</span>
    </a>
    <ul>
      <li><a href="/docs">Docs</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/benchmarks">Benchmarks</a></li>
      <li><a href="https://github.com/Micrurus-Ai/Corvid-lang" target="_blank" rel="noopener">GitHub</a></li>
    </ul>
  </nav>

  <slot />

  <footer class="pg-footer">
    <span>Typechecks in your browser. No code leaves the page.</span>
    <span aria-hidden="true">·</span>
    <a href="/install">curl install</a>
    <a href="/docs/book/01-install">Install guide</a>
    <a href="/docs/reference/guarantees">Guarantees</a>
    <a href="https://github.com/Micrurus-Ai/Corvid-lang/blob/main/docs/meta/playground-examples-contract.md" target="_blank" rel="noopener">Wire contract</a>
  </footer>
</body>
</html>
